apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: {{module}}-{{name}}-{{type}}
  name: {{module}}-{{name}}-{{type}}-deploy
  namespace: {{tenant}}-{{addon.ns}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{module}}-{{name}}-{{type}}
  template:
    metadata:
      labels:
        app: {{module}}-{{name}}-{{type}}
    spec:
      containers:
        - image: registry.gitlab.com/{{tenant}}-{{module}}/{{module}}-{{name}}-{{type}}:1
          imagePullPolicy: Always
          name: {{module}}-{{name}}-{{type}}
          ports:
            - containerPort: {{addon.port}}
              protocol: TCP
          envFrom:
            - configMapRef:
                name: {{module}}-config
      imagePullSecrets:
        - name: {{tenant}}-cred
      restartPolicy: Always

---

apiVersion: v1
kind: Service
metadata:
  labels:
    app: {{module}}-{{name}}-{{type}}
  name: {{module}}-{{name}}-{{type}}-svc
  namespace: {{tenant}}-{{addon.ns}}
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      targetPort: {{addon.port}}
  selector:
    app: {{module}}-{{name}}-{{type}}
