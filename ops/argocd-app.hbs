apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{to_kebab_case tenant}}-{{to_kebab_case module}}-{{addon.branch}}.app
  namespace: {{to_kebab_case tenant}}-argocd
spec:
  destination:
    namespace: {{to_kebab_case tenant}}-{{to_kebab_case module}}-{{addon.branch}}
    server: https://kubernetes.default.svc
  project: default
  source:
    path: {{to_kebab_case module}}-{{to_kebab_case name}}
    repoURL: https://gitlab.com/{{to_kebab_case tenant}}-{{to_kebab_case module}}/{{to_kebab_case module}}-cd.git
    targetRevision: {{addon.branch}}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - ApplyOutOfSyncOnly=true
