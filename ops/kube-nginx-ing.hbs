apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}-ing
  namespace: {{to_kebab_case tenant}}-{{addon.ns}}
spec:
  ingressClassName: nginx
  rules:
    - host: {{url}}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}-svc
                port:
                  number: 80
