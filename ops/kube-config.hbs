apiVersion: v1
kind: Secret
metadata:
  name: {{tenant}}-cred
  namespace: {{tenant}}-{{addon.ns}}
data:
  .dockerconfigjson: "{{addon.cred}}"
type: kubernetes.io/dockerconfigjson

---

apiVersion: v1
kind: ConfigMap
metadata:
  name: {{module}}-config
  namespace: {{tenant}}-{{addon.ns}}
data:
  {{constantCase module}}_DB: "{{addon.dbEnv}}"
  {{constantCase module}}_BASE_URL: "{{addon.baseUrl}}"
