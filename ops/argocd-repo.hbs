apiVersion: v1
kind: Secret
metadata:
  name: {{to_kebab_case tenant}}-{{to_kebab_case module}}.repo
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  project: default
  name: {{to_kebab_case tenant}}-{{to_kebab_case module}}.repo
  url: https://gitlab.com/{{to_kebab_case tenant}}-{{to_kebab_case module}}/{{to_kebab_case module}}-cd.git
  username: {{addon.user}}
  password: {{addon.pass}}
