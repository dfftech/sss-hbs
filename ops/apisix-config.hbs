{
    "uri": "/{{to_kebab_case module}}-{{to_kebab_case name}}/*",
    "name": "{{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}",
    "plugins": {
        "jwe-decrypt": {
            "header": "authorization",
            "forward_header": "session-info"
        },
        "proxy-rewrite": {
            "regex_uri": [
            "^/{{to_kebab_case module}}-{{to_kebab_case name}}/(.*)",
            "/$1"
            ]
        }
    },
    "upstream": {
        "nodes": [
        {
            "host": "{{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}-svc.{{to_kebab_case tenant}}-{{addon.ns}}.svc.cluster.local",
            "port": 80,
            "weight": 1
        }
        ],
        "type": "none",
        "scheme": "http"
    },
    "status": 1
}
