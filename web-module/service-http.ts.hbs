export const {{to_camel_case name}}ListIsLoading = signal(false);

export const {{to_camel_case name}}ListCall = async (
  params: RequestQueryType,
): Promise<ResponseType | undefined> => {
  try {
    {{to_camel_case name}}ListIsLoading.value = true;
    const resp = (await AppHttp.Get(
      MsUrl.api + "/{{to_kebab_case name}}/search",
      params as Record<string, string | number | boolean>,
    )) as ResponseType;
    return {
      ...resp,
      data: Array.isArray(resp?.data) ? (resp.data as {{to_pascal_case name}}Type[]) : [],
      total: Number(resp?.total || 0),
    };
  } catch (error: unknown) {
    const err = error as { error?: { message?: string } };
    ShowToast(t(err?.error?.message || AppProps.MESSAGE_INVALID_DATA), "warning");
  } finally {
    {{to_camel_case name}}ListIsLoading.value = false;
  }
};

