import { signal } from "@preact/signals-react";
import { t } from "i18next";
import { AppHttp } from "@/utils/services/app.http";
import { MsUrl } from "@/config/api.config";
import { ShowToast } from "@/utils/services/app.event";
import { AppProps } from "@/utils/services/app.props";
import { RequestBodyType, ResponseType } from "dff-util";

export const {{to_camel_case name}}SaveIsLoading = signal(false);

export const {{to_camel_case name}}SaveCall = async (
  params: RequestBodyType,
): Promise<ResponseType | undefined> => {
  try {
    {{to_camel_case name}}SaveIsLoading.value = true;
    const resp = (await AppHttp.Post(
      MsUrl.base + "/{{to_kebab_case name}}/save",
      params,
    )) as ResponseType;
    return resp;
  } catch (error: unknown) {
    const err = error as { error?: { message?: string } };
    ShowToast(t(err?.error?.message || AppProps.MESSAGE_INVALID_DATA), "warning");
  } finally {
    {{to_camel_case name}}SaveIsLoading.value = false;
  }
};
