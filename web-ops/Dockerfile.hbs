# Stage 1: Build the application with Bun
FROM oven/bun:1.4-alpine AS builder
WORKDIR /workspace

COPY package.json ./
RUN bun install

COPY . .
RUN bun run build

# Stage 2: Serve static export with nginx
FROM nginx:1.31-alpine AS production
ENV NODE_ENV=production

COPY --from=builder /workspace/out /usr/share/nginx/html

# __DOLLAR__ → $ via sed (single-line RUN — Kaniko cannot parse multi-line heredocs)
RUN sh -c 'printf "%s\n" "server {" "  listen 80;" "  root   /usr/share/nginx/html;" "  index  index.html index.htm;" "  absolute_redirect off;" "  port_in_redirect off;" "  rewrite ^(.+)/+$ __DOLLAR__1 permanent;" "" "  location / {" "    try_files __DOLLAR__uri __DOLLAR__uri.html __DOLLAR__uri/index.html /index.html;" "  }" "" "  error_page   500 502 503 504  /50x.html;" "" "  location = /50x.html {" "    root   /usr/share/nginx/html;" "  }" "}" | sed "s|__DOLLAR__|$(printf "\044")|g" > /etc/nginx/conf.d/default.conf'

RUN sh -c 'printf "%s\n" "#!/bin/sh" "mkdir -p /usr/share/nginx/html/assets" "{" "  echo \"window.env = {\"" "  env | grep -E \"^REACT_APP_\" | while IFS= read -r line; do" "    var_name=\"__DOLLAR__{line%%=*}\"" "    var_value=\"__DOLLAR__{line#*=}\"" "    printf \"  %s: \\\"%s\\\",\\n\" \"__DOLLAR__var_name\" \"__DOLLAR__var_value\"" "  done" "  echo \"};\"" "} > /usr/share/nginx/html/assets/env-config.js" | sed "s|__DOLLAR__|$(printf "\044")|g" > /docker-entrypoint.d/80-env-config.sh'
RUN chmod +x /docker-entrypoint.d/80-env-config.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
