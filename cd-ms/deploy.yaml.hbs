apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}
  name: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}-deploy
  namespace: {{to_kebab_case tenant}}-{{to_kebab_case module}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}
  template:
    metadata:
      labels:
        app: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}
    spec:
      containers:
        - image: registry.gitlab.com/{{to_kebab_case tenant}}-{{to_kebab_case module}}/{{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}:1
          imagePullPolicy: Always
          name: {{to_kebab_case module}}-{{to_kebab_case name}}-{{to_kebab_case type}}
          ports:
            - containerPort: 8080
              protocol: TCP
          envFrom:
            - configMapRef:
                name: {{to_kebab_case module}}-config
      imagePullSecrets:
        - name: {{to_kebab_case tenant}}-cred
      restartPolicy: Always
