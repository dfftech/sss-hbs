import React from 'react';
import { ICellRendererParams } from 'ag-grid-community';
import TypeIcon from '@/types/type.icon';

interface ReviewCellRendererProps extends ICellRendererParams {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    onAction: (data: any, action: 'edit' | 'status') => void;
}

const ReviewCellRenderer: React.FC<ReviewCellRendererProps> = ({ data, onAction }) => {
    const handleReview = () => {
        if (data) {
            onAction(data, 'edit');
        }
    };

    return (
        data && (
            <div className='flex items-center gap-2 p-2'>
                <div className='w-8 h-8 flex items-center justify-center'>
                    <TypeIcon
                        name='Eye'
                        className='cursor-pointer text-secondary'
                        size={24}
                        onClick={handleReview}
                    />
                </div>
            </div>
        )
    );
};

export default ReviewCellRenderer;
