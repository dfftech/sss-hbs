'use client';

import React from 'react';
import { useSignals } from '@preact/signals-react/runtime';
import { setTheme, themeSignal } from '@/utils/theme/theme.service';
import TypeIcon from '@/types/type.icon';
import { TypeDrawer } from '@/types/type.drawer';
import { SessionToken, RouterChange } from '@/utils/services/app.event';
import { AppRouter } from '@/utils/services/app.router';
import AppStorage, { SESSION_INFO } from '../services/app.storage';

export const Navbar = ({}: { onToggle?: () => void }) => {
  useSignals();

  const [isDrawerOpen, setIsDrawerOpen] = React.useState(false);
  const [mounted, setMounted] = React.useState(false);
  const sessionUser = AppStorage.getData(SESSION_INFO);
  const initials = (sessionUser?.name || 'User')
    .split(' ')
    .filter(Boolean)
    .map((word: string) => word[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
  const avatarBg = React.useMemo(() => {
    const colors = ['#ec4899', '#8b5cf6', '#f43f5e', '#6366f1', '#14b8a6', '#f59e0b'];
    const charCode = (sessionUser?.name || 'User').charCodeAt(0) || 0;
    return colors[charCode % colors.length];
  }, [sessionUser?.name]);

  React.useEffect(() => {
    setMounted(true);
  }, []);
  const isDarkMode = themeSignal.value === 'dark';

  const toggleTheme = () => {
    setTheme(themeSignal.value === 'dark' ? 'light' : 'dark');
  };

  return (
    <div className='container mx-auto'>
      <div className='navbar bg-white dark:bg-black shadow-sm border-b border-base-200 px-4 lg:px-6 py-2 flex items-center justify-between'>
        {/* Left Side: Logo */}
        <div className='flex items-center gap-2'>
          <div className='w-8 h-8 rounded-lg bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg shadow-md'>
            +
          </div>
          <span className='font-semibold text-lg tracking-wide text-base-content'>abetsie.com</span>
        </div>

        {/* Right Side: Device selector, Theme toggler, and Navigate */}
        <div className='flex items-center gap-4'>
          {/* Theme mode toggle */}
          <button
            onClick={toggleTheme}
            className='flex items-center justify-center w-9 h-9 cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 rounded-full transition bg-transparent border-none'
          >
            <TypeIcon name={isDarkMode ? 'Sun' : 'Moon'} size={20} />
          </button>

          {mounted && SessionToken.value && (
            <>
              {/* Notification Bell */}
              <div className='relative flex items-center justify-center w-9 h-9 cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 rounded-full transition'>
                <TypeIcon name='Bell' size={20} />
                <span className='absolute top-2 right-2 w-2 h-2 rounded-full bg-pink-500 border border-white dark:border-black' />
              </div>

              {/* User Avatar */}
              <div
                className='w-9 h-9 rounded-full flex items-center justify-center text-white font-extrabold text-xs shadow-sm'
                style=\{{ backgroundColor: avatarBg }}
              >
                {initials}
              </div>

              {/* Logout Button */}
              <button
                onClick={() => RouterChange(AppRouter.SIGN_IN)}
                className='flex items-center justify-center w-9 h-9 cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-800 rounded-full transition bg-transparent border-none'
              >
                <TypeIcon name='LogOut' size={20} />
              </button>
            </>
          )}
        </div>
      </div>

      <TypeDrawer isOpen={isDrawerOpen} onClose={() => setIsDrawerOpen(false)} width='w-80'>
        <div className='flex flex-col h-full py-4 bg-white dark:bg-zinc-950 text-gray-800 dark:text-zinc-100 font-sans select-none'>
          {/* Header */}
          <div className='flex items-center justify-between px-4 pb-4 border-b border-gray-100 dark:border-zinc-905'>
            <div className='flex items-center gap-2'>
              <div className='w-8 h-8 rounded-lg bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg shadow-md'>
                +
              </div>
              <span className='font-semibold text-lg tracking-wide text-gray-900 dark:text-white'>
                abetsie.com
              </span>
            </div>
            <button
              onClick={() => setIsDrawerOpen(false)}
              className='w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:bg-gray-100 dark:hover:bg-zinc-900 border-none bg-transparent cursor-pointer'
            >
              <TypeIcon name='X' size={18} />
            </button>
          </div>
        </div>
      </TypeDrawer>
    </div>
  );
};
